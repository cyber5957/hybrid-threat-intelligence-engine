# Temporary local admin-only access. Username-only access is for localhost development.
SENTINEL_ENV=development
SENTINEL_ADMIN_USERNAME=admin

# Optional reputation providers. Missing keys leave verdicts as unknown.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=

# Optional local service settings
SENTINEL_DB_PATH=data/sentinel.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
MAX_ALERT_CHARS=200000
